# Real email (Gmail example). To switch it on: delete the MAIL_MODE line,
# fill in the SMTP lines, and run: npm install nodemailer
MAIL_MODE=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourcollege@gmail.com
SMTP_PASS=your-16-letter-app-password
MAIL_FROM="Avanthi Institute <yourcollege@gmail.com>"
BASE_URL=https://your-website-address
ADMIN_NOTIFY_EMAIL=admin@example.com
NOTIFY_ADMIN_FOR_STUDENTS=false