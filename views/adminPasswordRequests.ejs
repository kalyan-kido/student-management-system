<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Password requests | <%= collegeName %></title>
<link rel="icon" href="/images/college-crest.png">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root { --dark:#2A0709; --red:#BF0716; --gold:#E2B229; --cream:#FBF8F4; --ink:#1B1614; --muted:#6E625A; --line:#E9E1D6; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Inter', sans-serif; background-image: linear-gradient(160deg, #FBF8F4 0%, #F4E9DA 100%); background-attachment: fixed; color: var(--ink); line-height: 1.5; }
  nav { background: linear-gradient(120deg, #5C0810 0%, #8E0510 45%, #BF0716 100%); color: #fff; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 14px 28px; border-bottom: 3px solid var(--gold); flex-wrap: wrap; }
  nav .brand { font-family: 'Cormorant Garamond', serif; font-size: 18px; display: flex; align-items: center; gap: 10px; }
  nav .brand::before { content: ''; flex: none; width: 36px; height: 36px; border-radius: 50%; background: #fff url('/images/college-crest.png') center / 86% no-repeat; box-shadow: 0 0 0 2px var(--gold); }
  nav .links { display: flex; gap: 20px; flex-wrap: wrap; }
  nav a { color: var(--gold); text-decoration: none; font-size: 13px; position: relative; transition: color .2s ease; }
  nav a:hover { color: #fff; }
  nav a::after { content: ''; position: absolute; left: 0; right: 0; bottom: -5px; height: 2px; background: var(--gold); transform: scaleX(0); transform-origin: left; transition: transform .28s ease; }
  nav a:hover::after { transform: scaleX(1); }
  .container { max-width: 960px; margin: 0 auto; padding: 40px 20px 64px; }
  .container > * { animation: riseIn .55s cubic-bezier(.2,.7,.2,1) both; }
  h1 { font-family: 'Cormorant Garamond', serif; font-size: 30px; }
  p.sub { color: var(--muted); margin-top: 4px; font-size: 14px; }
  section.block { margin-top: 32px; }
  section.block h2 { font-family: 'Cormorant Garamond', serif; font-size: 22px; }
  section.block p.hint { color: var(--muted); font-size: 13px; margin: 2px 0 14px; }
  .result { margin-top: 24px; background: #FFF6DA; border: 1px solid var(--gold); border-left: 5px solid var(--gold); border-radius: 8px; padding: 18px; }
  .result .temp { display: inline-block; margin: 10px 0; font-family: Consolas, 'Courier New', monospace; font-size: 24px; letter-spacing: 3px; background: #fff; border: 1px dashed var(--red); border-radius: 6px; padding: 8px 16px; user-select: all; }
  .result p { font-size: 13px; color: var(--muted); }
  .error { margin-top: 20px; background: #FDECEA; color: var(--red); padding: 12px 16px; border-radius: 8px; font-size: 14px; }
  .table-wrap { overflow-x: auto; background: #fff; border: 1px solid var(--line); border-radius: 8px; }
  table { width: 100%; border-collapse: collapse; min-width: 560px; }
  th { background: linear-gradient(120deg, #2A0709, #5C0810); color: #fff; padding: 12px; text-align: left; font-size: 12px; font-weight: 600; }
  td { padding: 10px 12px; border-top: 1px solid var(--line); font-size: 14px; vertical-align: middle; }
  tbody tr { transition: background-color .2s ease; }
  tbody tr:hover { background-color: rgba(191,7,22,0.05); }
  td.empty { color: var(--muted); text-align: center; padding: 22px 12px; }
  select, input[type=text] { padding: 9px 10px; border: 1px solid #D9CFC1; border-radius: 5px; font: inherit; font-size: 13px; background: #fff; }
  button { background: linear-gradient(135deg, #BF0716 0%, #E8283A 100%); color: #fff; border: none; padding: 9px 16px; border-radius: 6px; font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; transition: transform .15s ease, box-shadow .25s ease; }
  button:hover { background: linear-gradient(135deg, #8E0510 0%, #BF0716 100%); transform: translateY(-1px); box-shadow: 0 6px 14px rgba(191,7,22,.3); }
  button.ghost { background: transparent; color: var(--muted); border: 1px solid #D9CFC1; }
  button.ghost:hover { background: #fff; color: var(--red); box-shadow: none; }
  form.row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .direct { background: #fff; border: 1px solid var(--line); border-radius: 8px; padding: 18px; }
  .pill { font-size: 11px; font-weight: 600; padding: 2px 9px; border-radius: 999px; background: #F4E9DA; color: #5C0810; text-transform: capitalize; }
  @keyframes riseIn { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  @view-transition { navigation: auto; }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }
</style>
</head>
<body>
<nav>
  <div class="brand"><%= collegeName %></div>
  <div class="links">
    <a href="/admin-dashboard">Dashboard</a>
    <a href="/admin/add-student">Add Student</a>
    <a href="/admin/add-teacher">Add Teacher</a>
    <a href="/teacher-logout">Log out</a>
  </div>
</nav>

<div class="container">
  <div>
    <h1>Password requests</h1>
    <p class="sub">Signed in as <%= admin.name %></p>
  </div>

  <% if (error) { %>
    <div class="error"><%= error %></div>
  <% } %>

  <% if (result) { %>
    <div class="result">
      <strong>Temporary password for <%= result.label %></strong><br>
      <span class="temp"><%= result.temp %></span>
      <p>This is shown only once. Give it to the user in person or by phone. They must choose a new password the first time they log in. Do not send it in a public chat.</p>
    </div>
  <% } %>

  <section class="block">
    <h2>Open requests</h2>
    <p class="hint">Reset creates a one-time temporary password. Dismiss closes a request without changing anything.</p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Type</th><th>Name</th><th>Account</th><th>Requested (UTC)</th><th>Action</th></tr>
        </thead>
        <tbody>
          <% if (requests.length === 0) { %>
            <tr><td class="empty" colspan="5">No open requests.</td></tr>
          <% } %>
          <% requests.forEach(r => { %>
            <tr>
              <td><span class="pill"><%= r.type %></span></td>
              <td><%= r.name || 'Unknown' %></td>
              <td><%= r.account %></td>
              <td><%= r.created %></td>
              <td>
                <form class="row" method="POST" action="/admin/password-requests/<%= r.id %>/reset">
                  <button type="submit">Reset</button>
                </form>
                <form class="row" method="POST" action="/admin/password-requests/<%= r.id %>/dismiss" style="margin-top:6px">
                  <button type="submit" class="ghost">Dismiss</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="block">
    <h2>Reset any account</h2>
    <p class="hint">For someone who cannot use the form. Enter a student's email or university ID, or a staff email.</p>
    <form class="direct row" method="POST" action="/admin/password-requests/direct">
      <select name="type" aria-label="Account type">
        <option value="student">Student</option>
        <option value="teacher">Staff</option>
      </select>
      <input type="text" name="identifier" placeholder="Email or university ID" required style="min-width:260px">
      <button type="submit">Reset password</button>
    </form>
  </section>
</div>
</body>
</html>