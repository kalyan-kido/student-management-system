<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Forgot password | <%= collegeName %></title>
<link rel="icon" href="/images/college-crest.png">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root { --dark:#2A0709; --red:#BF0716; --gold:#E2B229; --cream:#FBF8F4; --ink:#1B1614; --muted:#6E625A; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: 'Poppins', sans-serif; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px;
    background: linear-gradient(135deg, rgba(20,4,5,0.90) 0%, rgba(142,5,16,0.80) 100%), url('/images/campus-hero.jpg') center / cover no-repeat fixed;
  }
  .card { background: var(--cream); border-radius: 10px; padding: 36px 32px; width: 100%; max-width: 380px; text-align: center; border-top: 4px solid var(--gold); animation: cardIn .6s cubic-bezier(.2,.7,.2,1) both; }
  .card img.brand-logo { width: 100%; max-width: 270px; height: auto; margin: 0 auto 12px; display: block; mix-blend-mode: multiply; }
  .card h1 { font-family: 'Playfair Display', serif; font-size: 22px; color: var(--ink); margin-bottom: 6px; }
  .card p.sub { color: var(--muted); font-size: 13px; margin-bottom: 20px; line-height: 1.6; }
  input { width: 100%; padding: 12px; margin-bottom: 14px; border: 1px solid #D9CFC1; border-radius: 6px; font-family: inherit; font-size: 14px; background: #fff; transition: border-color .25s ease, box-shadow .25s ease; }
  input:focus { outline: none; border-color: var(--red); box-shadow: 0 0 0 3px rgba(191,7,22,.18); }
  button { width: 100%; padding: 13px; background: linear-gradient(135deg, #BF0716 0%, #E8283A 100%); color: #fff; border: none; border-radius: 6px; font-family: inherit; font-weight: 600; font-size: 14px; cursor: pointer; transition: transform .15s ease, box-shadow .25s ease; }
  button:hover { background: linear-gradient(135deg, #8E0510 0%, #BF0716 100%); transform: translateY(-1px); box-shadow: 0 6px 14px rgba(191,7,22,.28); }
  .error { background: #FDECEA; color: var(--red); padding: 10px; border-radius: 6px; font-size: 13px; margin-bottom: 14px; animation: fadeIn .4s ease both; }
  .notice { background: #FFF6DA; border: 1px solid var(--gold); color: var(--ink); padding: 14px; border-radius: 8px; font-size: 13px; line-height: 1.6; text-align: left; animation: fadeIn .4s ease both; }
  .back { display: block; margin-top: 16px; color: var(--muted); font-size: 13px; text-decoration: none; transition: color .2s ease; }
  .back:hover { color: var(--red); }
  @keyframes cardIn { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  @view-transition { navigation: auto; }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }
</style>
</head>
<body>
  <div class="card">
    <img class="brand-logo" src="/images/avanthi-logo.png" alt="<%= collegeName %>">
    <h1>Forgot your password?</h1>

    <% if (sent) { %>
      <div class="notice">
        If an account exists for that <%= type === 'teacher' ? 'email' : 'email or university ID' %>, the college office has been notified.
        They will give you a temporary password, and you will be asked to choose a new one when you log in.
      </div>
    <% } else { %>
      <p class="sub"><%= type === 'teacher' ? 'Enter your staff email.' : 'Enter your email or university ID.' %> The college office will reset your password for you.</p>

      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>

      <form method="POST" action="/forgot-password">
        <input type="hidden" name="type" value="<%= type %>">
        <input type="text" name="identifier" placeholder="<%= type === 'teacher' ? 'Staff email' : 'Email or university ID' %>" required autocomplete="username">
        <button type="submit">Request reset</button>
      </form>
    <% } %>

    <a href="<%= type === 'teacher' ? '/teacher-login' : '/login' %>" class="back">&larr; Back to log in</a>
  </div>
</body>
</html>