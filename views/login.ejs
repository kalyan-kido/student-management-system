<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Log In — <%= collegeName %></title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --dark: #14100D;
    --red: #B3211E;
    --gold: #E8B923;
    --cream: #FDF8F0;
    --ink: #1B1614;
    --muted: #7A6F63;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: 'Inter', sans-serif;
    background: var(--dark);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .card {
    background: var(--cream);
    border-radius: 10px;
    padding: 40px 34px;
    width: 100%;
    max-width: 360px;
    text-align: center;
    border-top: 4px solid var(--gold);
  }
  .card img { width: 64px; margin-bottom: 14px; }
  .card h1 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 24px;
    color: var(--ink);
    margin-bottom: 4px;
  }
  .card p.sub { color: var(--muted); font-size: 13px; margin-bottom: 24px; }
  input {
    width: 100%;
    padding: 12px;
    margin-bottom: 14px;
    border: 1px solid #DDD3C2;
    border-radius: 6px;
    font-family: inherit;
    font-size: 14px;
    background: white;
  }
  input:focus { outline: 2px solid var(--gold); }
  button {
    width: 100%;
    padding: 13px;
    background: var(--red);
    color: white;
    border: none;
    border-radius: 6px;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
  }
  button:hover { opacity: 0.92; }
  .error {
    background: #FDECEA;
    color: var(--red);
    padding: 10px;
    border-radius: 6px;
    font-size: 13px;
    margin-bottom: 14px;
  }
  .back { display: block; margin-top: 14px; color: var(--muted); font-size: 13px; text-decoration: none; }
</style>
</head>
<body>
  <div class="card">
    <img src="/images/college-crest.png" alt="Crest">
    <h1><%= collegeName %></h1>
    <p class="sub">Student Portal Login</p>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <form method="POST" action="/login">
      <input type="email" name="email" placeholder="Email" required>
      <input type="password" name="password" placeholder="Password" required>
      <button type="submit">Log In</button>
    </form>

    <a href="/" class="back">← Back to home</a>
    <a href="/teacher-login" class="back">Faculty member? Log in here</a>
  </div>
</body>
</html>