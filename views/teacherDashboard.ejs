<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Faculty Dashboard — <%= collegeName %></title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root { --dark:#2A0709; --red:#BF0716; --gold:#E2B229; --cream:#FBF8F4; --ink:#1B1614; --muted:#6E625A; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Inter', sans-serif; background: var(--cream); color: var(--ink); }
  nav { background: var(--dark); color: white; display: flex; justify-content: space-between; align-items: center; padding: 14px 28px; border-bottom: 3px solid var(--red); }
  nav .logout { background: var(--red); color: white; padding: 8px 16px; border-radius: 5px; text-decoration: none; font-size: 13px; font-weight: 600; }
  .container { max-width: 800px; margin: 0 auto; padding: 40px 20px; }
  h1 { font-family: 'Cormorant Garamond', serif; font-size: 28px; }
  .role-badge { display: inline-block; background: var(--gold); color: var(--dark); font-size: 11px; font-weight: 700; padding: 3px 10px; border-radius: 10px; margin-left: 10px; text-transform: uppercase; }
  .assignment { display: block; background: white; border: 1px solid #E9E1D6; border-left: 4px solid var(--red); border-radius: 6px; padding: 16px 20px; margin-top: 14px; text-decoration: none; color: var(--ink); cursor: pointer; }
  .assignment:hover { box-shadow: 0 8px 20px rgba(0,0,0,0.06); }
  .assignment .subj { font-weight: 600; font-size: 15px; }
  .assignment .meta { color: var(--muted); font-size: 13px; margin-top: 3px; }

/* gradient-theme */
body { background-image: linear-gradient(160deg, #FBF8F4 0%, #F4E9DA 100%); background-attachment: fixed; }
nav { background: linear-gradient(120deg, #5C0810 0%, #8E0510 45%, #BF0716 100%) !important; border-bottom: 3px solid #E2B229 !important; }
th { background: linear-gradient(120deg, #2A0709, #5C0810) !important; }
button, .btn { background: linear-gradient(135deg, #BF0716 0%, #E8283A 100%) !important; transition: transform .15s ease, box-shadow .25s ease, filter .25s ease; }
button:hover, .btn:hover { background: linear-gradient(135deg, #8E0510 0%, #BF0716 100%) !important; transform: translateY(-1px); box-shadow: 0 6px 14px rgba(191,7,22,.3); }
button:active, .btn:active { transform: translateY(0); box-shadow: none; }

/* nav-crest */
nav > div:first-child { display: flex; align-items: center; gap: 10px; }
nav > div:first-child::before { content: ''; flex: none; width: 36px; height: 36px; border-radius: 50%; background: #fff url('/images/college-crest.png') center / 86% no-repeat; box-shadow: 0 0 0 2px #E2B229; }
</style>
  <link rel="icon" href="/images/college-crest.png">
</head>
<body>
  <nav>
    <div>Faculty Portal</div>
    <a href="/teacher-logout" class="logout">Log Out</a>
  </nav>
  <div class="container">
    <h1>Welcome, <%= teacher.name %><% if (teacher.role === 'incharge') { %><span class="role-badge">Incharge</span><% } %></h1>
    <p style="color: var(--muted); margin-top: 6px;">Click a class to enter marks:</p>

    <% assignments.forEach(a => { %>
      <a href="/teacher/marks/<%= a.section_id %>/<%= a.subject_id %>" class="assignment">
        <div class="subj"><%= a.subject_name %></div>
        <div class="meta"><%= a.branch_name %> · Year <%= a.year %>, Section <%= a.section_name %></div>
      </a>
    <% }) %>
  </div>
  <a href="/teacher/achievements">Manage Achievements</a>
</body>
</html>