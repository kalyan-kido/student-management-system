<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard — <%= collegeName %></title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --dark: #2A0709;
    --red: #BF0716;
    --gold: #E2B229;
    --cream: #FBF8F4;
    --ink: #1B1614;
    --muted: #6E625A;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Inter', sans-serif; background: var(--cream); color: var(--ink); }

  nav {
    background: var(--dark);
    color: white;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 28px;
    border-bottom: 3px solid var(--gold);
  }
  nav .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'Cormorant Garamond', serif;
    font-size: 18px;
    font-weight: 700;
  }
  nav .brand img { width: 32px; height: 32px; border-radius: 50%; }
  nav .logout {
    background: var(--red);
    color: white;
    padding: 8px 16px;
    border-radius: 5px;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
  }

  .container { max-width: 900px; margin: 0 auto; padding: 40px 20px; }

  .welcome h1 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 30px;
  }
  .welcome p { color: var(--muted); margin-top: 4px; font-size: 14px; }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 16px;
    margin: 28px 0 36px;
  }
  .info-box {
    background: white;
    border: 1px solid #E9E1D6;
    border-radius: 8px;
    padding: 18px;
  }
  .info-box .label { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; }
  .info-box .value { font-size: 17px; font-weight: 600; margin-top: 4px; }

  .quick-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 20px;
  }
  .link-card {
    background: white;
    border: 1px solid #E9E1D6;
    border-top: 3px solid var(--gold);
    border-radius: 8px;
    padding: 26px 20px;
    text-align: center;
    text-decoration: none;
    color: var(--ink);
  }
  .link-card:hover { box-shadow: 0 8px 20px rgba(0,0,0,0.06); }
  .link-card .icon { font-size: 24px; margin-bottom: 8px; }
  .link-card h3 { font-size: 14px; font-weight: 600; }

/* gradient-theme */
body { background-image: linear-gradient(160deg, #FBF8F4 0%, #F4E9DA 100%); background-attachment: fixed; }
nav { background: linear-gradient(120deg, #5C0810 0%, #8E0510 45%, #BF0716 100%) !important; border-bottom: 3px solid #E2B229 !important; }
th { background: linear-gradient(120deg, #2A0709, #5C0810) !important; }
button, .btn { background: linear-gradient(135deg, #BF0716 0%, #E8283A 100%) !important; transition: transform .15s ease, box-shadow .25s ease, filter .25s ease; }
button:hover, .btn:hover { background: linear-gradient(135deg, #8E0510 0%, #BF0716 100%) !important; transform: translateY(-1px); box-shadow: 0 6px 14px rgba(191,7,22,.3); }
button:active, .btn:active { transform: translateY(0); box-shadow: none; }

/* nav-crest */
nav > div:first-child { display: flex; align-items: center; gap: 10px; }
nav > div:first-child::before { content: ''; flex: none; width: 36px; height: 36px; border-radius: 50%; background: #fff url('/images/college-crest.png') center / 86% no-repeat; box-shadow: 0 0 0 2px #E2B229; }

/* page-transition */
@view-transition { navigation: auto; }
@keyframes vtOut { to { opacity: 0; transform: translateY(-8px); } }
@keyframes vtIn { from { opacity: 0; transform: translateY(12px); } }
::view-transition-old(root) { animation: .22s ease both vtOut; }
::view-transition-new(root) { animation: .4s ease both vtIn; }
@media (prefers-reduced-motion: reduce) {
  ::view-transition-group(*), ::view-transition-old(*), ::view-transition-new(*) { animation: none !important; }
}
/* motion-theme */
@keyframes riseIn { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
.container > * { animation: riseIn .55s cubic-bezier(.2,.7,.2,1) both; }
.container > *:nth-child(2) { animation-delay: .07s; }
.container > *:nth-child(3) { animation-delay: .14s; }
.container > *:nth-child(4) { animation-delay: .21s; }
.container > *:nth-child(5) { animation-delay: .28s; }
.container > *:nth-child(n+6) { animation-delay: .35s; }
.info-grid > *, .stats > *, .cards > * { animation: riseIn .5s cubic-bezier(.2,.7,.2,1) both; }
.info-grid > *:nth-child(2), .stats > *:nth-child(2), .cards > *:nth-child(2) { animation-delay: .08s; }
.info-grid > *:nth-child(3), .stats > *:nth-child(3), .cards > *:nth-child(3) { animation-delay: .16s; }
.info-grid > *:nth-child(n+4), .stats > *:nth-child(n+4), .cards > *:nth-child(n+4) { animation-delay: .24s; }
nav .links a { position: relative; transition: color .2s ease; }
nav .links a:hover { text-decoration: none; color: #fff; }
nav .links a::after { content: ''; position: absolute; left: 0; right: 0; bottom: -5px; height: 2px; background: #E2B229; transform: scaleX(0); transform-origin: left; transition: transform .28s ease; }
nav .links a:hover::after { transform: scaleX(1); }
tbody tr { transition: background-color .2s ease; }
tbody tr:hover { background-color: rgba(191,7,22,0.05); }
.table-wrap, form.stack { transition: box-shadow .3s ease; }
.table-wrap:hover, form.stack:hover { box-shadow: 0 12px 28px rgba(20,4,5,0.10); }
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation: none !important; transition: none !important; }
}
</style>
  <link rel="icon" href="/images/college-crest.png">
</head>
<body>

  <nav>
    <div class="brand">
      <img src="/images/college-crest.png" alt="Crest">
      <%= collegeName %>
    </div>
    <a href="/logout" class="logout">Log Out</a>
  </nav>

  <div class="container">
<div class="welcome">
  <h1>Welcome, <%= student.name %></h1>
  <p><%= student.branch_name %> · <%= student.section_name ? 'Year ' + student.section_year + ', Section ' + student.section_name : 'Section not assigned yet' %> · <% const info = parseId(student.university_id); %><%= info.studyYear ? info.yearLabel + ' (Sem ' + info.semesterLabel + ')' : info.yearLabel %> · Class of <%= info.graduationYear %> · <%= student.admission_type %></p>
</div>

<div class="info-grid">
  <div class="info-box">
    <div class="label">University ID</div>
    <div class="value"><%= student.university_id %></div>
  </div>
  <div class="info-box">
    <div class="label">Section</div>
    <div class="value"><%= student.section_name ? 'Year ' + student.section_year + ' - ' + student.section_name : 'Not assigned yet' %></div>
  </div>
  <div class="info-box">
    <div class="label">Branch</div>
    <div class="value"><%= student.branch_name %></div>
  </div>
  <div class="info-box">
    <div class="label">Admission Type</div>
    <div class="value"><%= student.admission_type %></div>
  </div>
  <div class="info-box">
    <div class="label">Student Phone</div>
    <div class="value"><%= student.student_phone %></div>
  </div>
  <div class="info-box">
    <div class="label">Parent Phone</div>
    <div class="value"><%= student.parent_phone %></div>
  </div>
  <div class="info-box" style="grid-column: 1 / -1;">
    <div class="label">Address</div>
    <div class="value"><%= student.address %></div>
  </div>
</div>

<h2 style="font-family: 'Cormorant Garamond', serif; font-size: 22px; margin-bottom: 14px;">Academic Record</h2>

<% if (marks.length === 0) { %>
  <div class="info-box" style="margin-bottom: 36px;">
    <p style="color: var(--muted); font-size: 14px;">No marks recorded yet.</p>
  </div>
<% } else { %>
  <table style="width: 100%; border-collapse: collapse; background: white; border: 1px solid #E9E1D6; border-radius: 8px; overflow: hidden; margin-bottom: 36px;">
    <thead>
      <tr style="background: var(--dark); color: white;">
        <th style="padding: 12px; text-align: left; font-size: 13px;">Subject</th>
        <th style="padding: 12px; text-align: left; font-size: 13px;">Semester</th>
<th style="padding: 12px; text-align: left; font-size: 13px;">Score</th>
        <th style="padding: 12px; text-align: left; font-size: 13px;">Grade</th>
      </tr>
    </thead>
    <tbody>
      <% marks.forEach(m => { %>
        <tr style="border-top: 1px solid #E9E1D6;">
          <td style="padding: 12px; font-size: 14px;"><%= m.subject_name %></td>
          <td style="padding: 12px; font-size: 14px;"><%= m.semester %></td>
<td style="padding: 12px; font-size: 14px; font-weight: 600;"><%= m.score %> / <%= m.max_score %></td>
          <td style="padding: 12px; font-size: 14px; font-weight: 700; color: var(--red);"><%= m.grade %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
    <div class="quick-links">
      <a href="/timetable" class="link-card">
        <div class="icon">📅</div>
        <h3>Timetable</h3>
      </a>
      <a href="/fees" class="link-card">
        <div class="icon">💳</div>
        <h3>Fees</h3>
      </a>
      <a href="/achievements" class="link-card">
        <div class="icon">🏆</div>
        <h3>Achievements</h3>
      </a>
    </div>
  </div>

</body>
</html>
