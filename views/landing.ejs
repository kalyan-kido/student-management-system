<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Avanthi Institute of Engineering & Technology — Student Portal</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --dark: #2A0709;
    --dark-light: #241C16;
    --red: #BF0716;
    --gold: #E2B229;
    --cream: #FBF8F4;
    --ink: #1B1614;
    --muted: #6E625A;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Inter', sans-serif;
    background: var(--cream);
    color: var(--ink);
  }

  #splash {
    position: fixed;
    inset: 0;
    background: var(--dark);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 999;
    transition: opacity 0.6s ease, visibility 0.6s ease;
  }

  #splash.hide { opacity: 0; visibility: hidden; }

  #splash img {
    width: 130px;
    height: 130px;
    border-radius: 50%;
    animation: pop 0.7s ease;
    box-shadow: 0 0 40px rgba(232,185,35,0.25);
  }

  .splash-name {
    margin-top: 20px;
    color: var(--gold);
    font-family: 'Cormorant Garamond', serif;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-align: center;
    animation: fadeUp 0.8s ease 0.2s both;
  }

  @keyframes pop {
    0% { transform: scale(0.5); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }
  @keyframes fadeUp {
    0% { transform: translateY(8px); opacity: 0; }
    100% { transform: translateY(0); opacity: 1; }
  }

  .hero {
    background: linear-gradient(160deg, var(--dark), var(--dark-light));
    color: white;
    text-align: center;
    padding: 70px 20px 60px;
    position: relative;
    border-bottom: 4px solid var(--gold);
  }

  .crest {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    margin: 0 auto 20px;
    box-shadow: 0 0 0 3px var(--gold);
  }

  .hero h1 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 38px;
    font-weight: 700;
    letter-spacing: 0.5px;
    line-height: 1.3;
  }

  .hero .location {
    color: var(--gold);
    font-size: 13px;
    letter-spacing: 2px;
    margin-top: 6px;
    text-transform: uppercase;
  }

  .hero p.tagline {
    color: #D8CFC4;
    margin-top: 14px;
    font-size: 14px;
    letter-spacing: 0.5px;
  }

  .login-btn {
    display: inline-block;
    margin-top: 30px;
    background: var(--red);
    color: white;
    padding: 13px 32px;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.5px;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .login-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(191,7,22,0.35);
  }

  .login-btn.secondary {
    background: transparent;
    border: 1px solid var(--gold);
    color: var(--gold);
    margin-left: 10px;
  }

  .quick-links {
    max-width: 820px;
    margin: 0 auto;
    padding: 56px 20px 70px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 20px;
  }

  .link-card {
    background: white;
    border: 1px solid #E9E1D6;
    border-top: 3px solid var(--gold);
    border-radius: 8px;
    padding: 28px 20px;
    text-align: center;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    display: block;
  }

  .link-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(0,0,0,0.08);
  }

  .link-card .icon { font-size: 26px; margin-bottom: 10px; }
  .link-card h3 { font-size: 15px; font-weight: 600; margin-bottom: 4px; }
  .link-card p { font-size: 13px; color: var(--muted); }

  .footer-note {
    text-align: center;
    color: var(--muted);
    font-size: 13px;
    padding: 20px 0 40px;
    border-top: 1px solid #E9E1D6;
  }

  /* college-theme */
  body { background: linear-gradient(180deg, #FBF8F4 0%, #F4E9DA 100%); }

  #splash { background: #140405; overflow: hidden; }
  #splash .splash-bg {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(20,4,5,0.55) 0%, rgba(142,5,16,0.80) 55%, rgba(20,4,5,0.95) 100%),
      url('/images/campus-hero.jpg') center / cover no-repeat;
    transform: scale(1.06);
    animation: slowZoom 6s ease-out forwards;
  }
  #splash .splash-content { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; padding: 0 20px; }
  #splash .splash-crest { width: 130px; height: 130px; border-radius: 50%; background: #fff; padding: 4px; box-shadow: 0 0 0 3px #E2B229, 0 0 40px rgba(226,178,41,0.35); }
  .splash-title { font-family: 'Cormorant Garamond', serif; font-size: clamp(44px, 8vw, 76px); font-weight: 700; color: #fff; letter-spacing: 6px; margin-top: 22px; line-height: 1.1; text-shadow: 0 3px 18px rgba(0,0,0,0.55); animation: fadeUp 0.8s ease 0.2s both; }
  .splash-sub { color: #E2B229; letter-spacing: 2.5px; text-transform: uppercase; font-size: clamp(12px, 2.2vw, 16px); margin-top: 8px; font-weight: 600; animation: fadeUp 0.8s ease 0.35s both; }
  .splash-tag { color: rgba(255,255,255,0.88); margin-top: 14px; font-size: 15px; animation: fadeUp 0.8s ease 0.5s both; }
  .splash-bar { width: min(320px, 70vw); height: 4px; background: rgba(255,255,255,0.2); border-radius: 4px; overflow: hidden; margin-top: 26px; }
  .splash-bar span { display: block; height: 100%; background: linear-gradient(90deg, #E2B229, #F6D365); animation: loadBar 2s ease forwards; }
  @keyframes slowZoom { from { transform: scale(1.06); } to { transform: scale(1); } }
  @keyframes loadBar { from { width: 0; } to { width: 100%; } }

  .hero {
    background:
      linear-gradient(180deg, rgba(20,4,5,0.45) 0%, rgba(142,5,16,0.72) 60%, rgba(20,4,5,0.92) 100%),
      url('/images/campus-hero.jpg') center / cover no-repeat;
    padding: 110px 20px 90px;
    border-bottom: 4px solid #E2B229;
  }
  .crest { background: #fff; padding: 3px; box-shadow: 0 0 0 3px #E2B229, 0 8px 24px rgba(0,0,0,0.4); }
  .hero h1 { text-shadow: 0 2px 14px rgba(0,0,0,0.55); }
  .hero .location, .hero p.tagline { text-shadow: 0 1px 8px rgba(0,0,0,0.55); }
  .hero p.tagline { color: #fff; }
  .login-btn { background: linear-gradient(135deg, #BF0716 0%, #E8283A 100%); }
  .login-btn:hover { box-shadow: 0 8px 20px rgba(191,7,22,0.4); }
  .login-btn.secondary { background: rgba(255,255,255,0.12); border: 1px solid #E2B229; color: #E2B229; }
  .link-card { border-top: 3px solid #BF0716; }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; } }

  /* banner-strip */
  .banner-strip { max-width: 1100px; margin: -48px auto 0; padding: 0 20px; position: relative; z-index: 2; }
  .banner-strip img { width: 100%; height: auto; display: block; border-radius: 14px; border: 3px solid #E2B229; box-shadow: 0 20px 44px rgba(20,4,5,0.38); animation: bannerRise .9s cubic-bezier(.2,.7,.2,1) .15s both; }
  @keyframes bannerRise { from { opacity: 0; transform: translateY(26px) scale(.985); } to { opacity: 1; transform: none; } }
  .quick-links { padding-top: 40px; }
/* page-transition */
@view-transition { navigation: auto; }
@keyframes vtOut { to { opacity: 0; transform: translateY(-8px); } }
@keyframes vtIn { from { opacity: 0; transform: translateY(12px); } }
::view-transition-old(root) { animation: .22s ease both vtOut; }
::view-transition-new(root) { animation: .4s ease both vtIn; }
@media (prefers-reduced-motion: reduce) {
  ::view-transition-group(*), ::view-transition-old(*), ::view-transition-new(*) { animation: none !important; }
}
</style>
  <link rel="icon" href="/images/college-crest.png">
</head>
<body>

  <div id="splash">
    <div class="splash-bg"></div>
    <div class="splash-content">
      <img class="splash-crest" src="/images/college-crest.png" alt="College Crest">
      <h1 class="splash-title">AVANTHI</h1>
      <div class="splash-sub">Institute of Engineering &amp; Technology</div>
      <div class="splash-tag">Student &amp; Faculty Portal</div>
      <div class="splash-bar"><span></span></div>
    </div>
  </div>

  <div class="hero">
    <img class="crest" src="/images/college-crest.png" alt="College Crest">
    <h1><%= collegeName %></h1>
    <div class="location">Vizianagaram · Hyderabad</div>
    <p class="tagline">Student & Faculty Portal</p>
    <a href="/login" class="login-btn">Student Log In</a>
    <a href="/teacher-login" class="login-btn secondary">Faculty Log In</a>
  </div>

  <div class="banner-strip"><img src="/images/campus-splash.jpg" width="1920" height="768" alt="Avanthi Institute of Engineering and Technology, Vizianagaram"></div>

  <div class="quick-links">
    <a href="/timetable" class="link-card">
      <div class="icon">📅</div>
      <h3>Timetable</h3>
      <p>View your weekly schedule</p>
    </a>
    <a href="/fees" class="link-card">
      <div class="icon">💳</div>
      <h3>Fees</h3>
      <p>Check balance & payments</p>
    </a>
    <a href="/achievements" class="link-card">
      <div class="icon">🏆</div>
      <h3>Achievements</h3>
      <p>Track your milestones</p>
    </a>
  </div>

  <p class="footer-note">© <%= currentYear %> <%= collegeName %>. All rights reserved.</p>

  <script>
    window.addEventListener('load', () => {
      setTimeout(() => {
        document.getElementById('splash').classList.add('hide');
      }, 2200);
    });
  </script>
</body>
</html>