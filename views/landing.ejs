<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Avanthi Institute of Engineering & Technology — Student Portal</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --dark: #14100D;
    --dark-light: #241C16;
    --red: #B3211E;
    --gold: #E8B923;
    --cream: #FDF8F0;
    --ink: #1B1614;
    --muted: #7A6F63;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Inter', sans-serif;
    background: var(--cream);
    color: var(--ink);
  }

  #splash {
    position: fixed;
    inset: 0;
    background: var(--dark);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 999;
    transition: opacity 0.6s ease, visibility 0.6s ease;
  }

  #splash.hide { opacity: 0; visibility: hidden; }

  #splash img {
    width: 130px;
    height: 130px;
    border-radius: 50%;
    animation: pop 0.7s ease;
    box-shadow: 0 0 40px rgba(232,185,35,0.25);
  }

  .splash-name {
    margin-top: 20px;
    color: var(--gold);
    font-family: 'Cormorant Garamond', serif;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-align: center;
    animation: fadeUp 0.8s ease 0.2s both;
  }

  @keyframes pop {
    0% { transform: scale(0.5); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }
  @keyframes fadeUp {
    0% { transform: translateY(8px); opacity: 0; }
    100% { transform: translateY(0); opacity: 1; }
  }

  .hero {
    background: linear-gradient(160deg, var(--dark), var(--dark-light));
    color: white;
    text-align: center;
    padding: 70px 20px 60px;
    position: relative;
    border-bottom: 4px solid var(--gold);
  }

  .crest {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    margin: 0 auto 20px;
    box-shadow: 0 0 0 3px var(--gold);
  }

  .hero h1 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 38px;
    font-weight: 700;
    letter-spacing: 0.5px;
    line-height: 1.3;
  }

  .hero .location {
    color: var(--gold);
    font-size: 13px;
    letter-spacing: 2px;
    margin-top: 6px;
    text-transform: uppercase;
  }

  .hero p.tagline {
    color: #D8CFC4;
    margin-top: 14px;
    font-size: 14px;
    letter-spacing: 0.5px;
  }

  .login-btn {
    display: inline-block;
    margin-top: 30px;
    background: var(--red);
    color: white;
    padding: 13px 32px;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.5px;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .login-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(179,33,30,0.35);
  }

  .login-btn.secondary {
    background: transparent;
    border: 1px solid var(--gold);
    color: var(--gold);
    margin-left: 10px;
  }

  .quick-links {
    max-width: 820px;
    margin: 0 auto;
    padding: 56px 20px 70px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 20px;
  }

  .link-card {
    background: white;
    border: 1px solid #EAE1D3;
    border-top: 3px solid var(--gold);
    border-radius: 8px;
    padding: 28px 20px;
    text-align: center;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    display: block;
  }

  .link-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(0,0,0,0.08);
  }

  .link-card .icon { font-size: 26px; margin-bottom: 10px; }
  .link-card h3 { font-size: 15px; font-weight: 600; margin-bottom: 4px; }
  .link-card p { font-size: 13px; color: var(--muted); }

  .footer-note {
    text-align: center;
    color: var(--muted);
    font-size: 13px;
    padding: 20px 0 40px;
    border-top: 1px solid #EAE1D3;
  }
</style>
</head>
<body>

  <div id="splash">
    <img src="/images/college-crest.png" alt="College Crest">
    <div class="splash-name">Avanthi Institute of Engineering<br>& Technology</div>
  </div>

  <div class="hero">
    <img class="crest" src="/images/college-crest.png" alt="College Crest">
    <h1><%= collegeName %></h1>
    <div class="location">Vizianagaram · Hyderabad</div>
    <p class="tagline">Student & Faculty Portal</p>
    <a href="/login" class="login-btn">Student Log In</a>
    <a href="/teacher-login" class="login-btn secondary">Faculty Log In</a>
  </div>

  <div class="quick-links">
    <a href="/timetable" class="link-card">
      <div class="icon">📅</div>
      <h3>Timetable</h3>
      <p>View your weekly schedule</p>
    </a>
    <a href="/fees" class="link-card">
      <div class="icon">💳</div>
      <h3>Fees</h3>
      <p>Check balance & payments</p>
    </a>
    <a href="/achievements" class="link-card">
      <div class="icon">🏆</div>
      <h3>Achievements</h3>
      <p>Track your milestones</p>
    </a>
  </div>

  <p class="footer-note">© <%= currentYear %> <%= collegeName %>. All rights reserved.</p>

  <script>
    window.addEventListener('load', () => {
      setTimeout(() => {
        document.getElementById('splash').classList.add('hide');
      }, 1000);
    });
  </script>
</body>
</html>