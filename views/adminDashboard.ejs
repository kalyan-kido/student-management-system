<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin dashboard | <%= collegeName %></title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root { --dark:#14100D; --red:#B3211E; --gold:#E8B923; --cream:#FDF8F0; --ink:#1B1614; --muted:#7A6F63; --line:#EAE1D3; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Inter', sans-serif; background: var(--cream); color: var(--ink); line-height: 1.5; }

  nav { background: var(--dark); color: white; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 14px 28px; border-bottom: 3px solid var(--red); }
  nav .brand { font-family: 'Cormorant Garamond', serif; font-size: 18px; }
  nav .links { display: flex; gap: 20px; }
  nav a { color: var(--gold); text-decoration: none; font-size: 13px; }
  nav a:hover { text-decoration: underline; }

  .container { max-width: 960px; margin: 0 auto; padding: 40px 20px 64px; }
  h1 { font-family: 'Cormorant Garamond', serif; font-size: 30px; }
  p.sub { color: var(--muted); margin-top: 4px; font-size: 14px; }
  p.status { margin: 20px 0 8px; font-size: 15px; padding: 12px 16px; background: white; border: 1px solid var(--line); border-left: 4px solid var(--gold); border-radius: 8px; }

  section.block { margin-top: 40px; }
  section.block h2 { font-family: 'Cormorant Garamond', serif; font-size: 22px; }
  section.block p.hint { color: var(--muted); font-size: 13px; margin: 2px 0 14px; }

  .table-wrap { overflow-x: auto; background: white; border: 1px solid var(--line); border-radius: 8px; }
  table { width: 100%; border-collapse: collapse; min-width: 560px; }
  th { background: var(--dark); color: white; padding: 12px; text-align: left; font-size: 12px; font-weight: 600; }
  td { padding: 10px 12px; border-top: 1px solid var(--line); font-size: 14px; vertical-align: middle; }
  th:first-child, td:first-child { padding-left: 16px; }
  td.empty { color: var(--muted); text-align: center; padding: 22px 12px; }

  select { padding: 8px; border: 1px solid #DDD3C2; border-radius: 5px; font: inherit; font-size: 13px; background: white; color: var(--ink); max-width: 100%; }
  button { background: var(--red); color: white; border: none; padding: 9px 16px; border-radius: 6px; font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; white-space: nowrap; }
  button:hover { background: #961A17; }
  select:focus-visible, button:focus-visible, a:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }

  form.row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }

  form.stack { background: white; border: 1px solid var(--line); border-radius: 8px; padding: 18px; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; align-items: end; }
  form.stack label { display: block; font-size: 13px; font-weight: 500; margin-bottom: 4px; }
  form.stack select { width: 100%; padding: 10px; }
  form.stack button { padding: 11px 16px; }

  .muted { color: var(--muted); }
</style>
</head>
<body>
<nav>
  <div class="brand"><%= collegeName %></div>
  <div class="links">
    <a href="/admin/add-student">Add Student</a>
    <a href="/admin/add-teacher">Add Teacher</a>
    <a href="/teacher/achievements">Achievements</a>
    <a href="/teacher/activities">Activities</a>
    <a href="/teacher-logout">Log out</a>
  </div>
</nav>

<div class="container">
  <h1>Admin dashboard</h1>
  <p class="sub">Signed in as <%= admin.name %></p>

  <% if (unassignedStudents.length > 0) { %>
    <p class="status"><%= unassignedStudents.length %> <%= unassignedStudents.length === 1 ? 'student is' : 'students are' %> waiting for a section. Assign them below so they can see their timetable.</p>
  <% } else { %>
    <p class="status">Every student has a section.</p>
  <% } %>

  <section class="block">
    <h2>Students waiting for a section</h2>
    <p class="hint">Pick a section for each student and select Assign section.</p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Student</th><th>University ID</th><th>Email</th><th>Section</th></tr>
        </thead>
        <tbody>
          <% if (unassignedStudents.length === 0) { %>
            <tr><td class="empty" colspan="4">No students are waiting. New sign-ups will appear here.</td></tr>
          <% } %>
          <% unassignedStudents.forEach(st => { %>
            <tr>
              <td><%= st.name %></td>
              <td><%= st.university_id %></td>
              <td class="muted"><%= st.email %></td>
              <td>
                <form class="row" method="POST" action="/admin/assign-section">
                  <input type="hidden" name="universityId" value="<%= st.university_id %>">
                  <select name="sectionId" required aria-label="Section for <%= st.name %>">
                    <option value="" disabled selected>Choose a section</option>
                    <% sections.forEach(sec => { %>
                      <option value="<%= sec.id %>"><%= sec.branch_name %>, Year <%= sec.year %>, Section <%= sec.section_name %></option>
                    <% }) %>
                  </select>
                  <button type="submit">Assign section</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="block">
    <h2>All students</h2>
    <p class="hint">Edit any student's personal details.</p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Student</th><th>University ID</th><th>Email</th><th></th></tr>
        </thead>
        <tbody>
          <% if (allStudents.length === 0) { %>
            <tr><td class="empty" colspan="4">No students yet.</td></tr>
          <% } %>
          <% allStudents.forEach(st => { %>
            <tr>
              <td><%= st.name %></td>
              <td><%= st.university_id %></td>
              <td class="muted"><%= st.email %></td>
              <td><a href="/admin/edit-student/<%= st.university_id %>">Edit</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="block">
    <h2>Add a branch</h2>
    <p class="hint">Create a branch before adding subjects or sections for it.</p>
    <form class="stack" method="POST" action="/admin/add-branch">
      <div>
        <label for="b-code">Branch code</label>
        <input id="b-code" name="code" type="text" placeholder="e.g. CSE" required>
      </div>
      <div>
        <label for="b-name">Branch name</label>
        <input id="b-name" name="name" type="text" placeholder="e.g. Computer Science Engineering" required>
      </div>
      <div>
        <button type="submit">Add branch</button>
      </div>
    </form>
  </section>

  <section class="block">
    <h2>All branches</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Code</th><th>Name</th></tr>
        </thead>
        <tbody>
          <% if (branches.length === 0) { %>
            <tr><td class="empty" colspan="2">No branches yet. Add one above.</td></tr>
          <% } %>
          <% branches.forEach(b => { %>
            <tr>
              <td><%= b.code %></td>
              <td><%= b.name %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="block">
    <h2>Add a subject</h2>
    <p class="hint">Create a subject for a branch and year before assigning it to a teacher.</p>
    <form class="stack" method="POST" action="/admin/add-subject">
      <div>
        <label for="s-name">Subject name</label>
        <input id="s-name" name="name" type="text" required>
      </div>
      <div>
        <label for="s-branch">Branch</label>
        <select id="s-branch" name="branchCode" required>
          <option value="" disabled selected>Choose a branch</option>
          <% branches.forEach(b => { %>
            <option value="<%= b.code %>"><%= b.name %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label for="s-year">Year</label>
        <select id="s-year" name="year" required>
          <option value="" disabled selected>Choose a year</option>
          <option value="1">1</option>
          <option value="2">2</option>
          <option value="3">3</option>
          <option value="4">4</option>
        </select>
      </div>
      <div>
        <button type="submit">Add subject</button>
      </div>
    </form>
  </section>

  <section class="block">
    <h2>Add a class section</h2>
    <p class="hint">Create a section (e.g. Year 2, Section A) before assigning students or teachers to it.</p>
    <form class="stack" method="POST" action="/admin/add-section">
      <div>
        <label for="sec-name">Section name</label>
        <input id="sec-name" name="sectionName" type="text" placeholder="e.g. A" required>
      </div>
      <div>
        <label for="sec-branch">Branch</label>
        <select id="sec-branch" name="branchCode" required>
          <option value="" disabled selected>Choose a branch</option>
          <% branches.forEach(b => { %>
            <option value="<%= b.code %>"><%= b.name %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label for="sec-year">Year</label>
        <select id="sec-year" name="year" required>
          <option value="" disabled selected>Choose a year</option>
          <option value="1">1</option>
          <option value="2">2</option>
          <option value="3">3</option>
          <option value="4">4</option>
        </select>
      </div>
      <div>
        <button type="submit">Add section</button>
      </div>
    </form>
  </section>

  <section class="block">
    <h2>Assign a teacher to a subject</h2>
    <p class="hint">This lets the teacher enter marks for that subject in that section.</p>
    <form class="stack" method="POST" action="/admin/assign-teacher-subject">
      <div>
        <label for="a-section">Section</label>
        <select id="a-section" name="sectionId" required>
          <option value="" disabled selected>Choose a section</option>
          <% sections.forEach(sec => { %>
            <option value="<%= sec.id %>"><%= sec.branch_name %>, Year <%= sec.year %>, Section <%= sec.section_name %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label for="a-subject">Subject</label>
        <select id="a-subject" name="subjectId" required>
          <option value="" disabled selected>Choose a subject</option>
          <% subjects.forEach(sub => { %>
            <option value="<%= sub.id %>"><%= sub.name %> (<%= sub.branch_code %>, Year <%= sub.year %>)</option>
          <% }) %>
        </select>
      </div>
      <div>
        <label for="a-teacher">Teacher</label>
        <select id="a-teacher" name="teacherId" required>
          <option value="" disabled selected>Choose a teacher</option>
          <% teachers.forEach(t => { %>
            <option value="<%= t.id %>"><%= t.name %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <button type="submit">Assign teacher</button>
      </div>
    </form>
  </section>

  <section class="block">
    <h2>Section incharges</h2>
    <p class="hint">An incharge can enter marks for every subject in their section.</p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Section</th><th>Current incharge</th><th>Change incharge</th></tr>
        </thead>
        <tbody>
          <% if (sections.length === 0) { %>
            <tr><td class="empty" colspan="3">No sections yet. Add sections to the database first.</td></tr>
          <% } %>
          <% sections.forEach(sec => {
               const current = teachers.find(t => t.id == sec.incharge_id);
          %>
            <tr>
              <td><%= sec.branch_name %>, Year <%= sec.year %>, Section <%= sec.section_name %></td>
              <td><%= current ? current.name : 'Not set' %></td>
              <td>
                <form class="row" method="POST" action="/admin/set-incharge">
                  <input type="hidden" name="sectionId" value="<%= sec.id %>">
                  <select name="teacherId" required aria-label="Incharge for section <%= sec.section_name %>">
                    <option value="" disabled <%= current ? '' : 'selected' %>>Choose a teacher</option>
                    <% teachers.forEach(t => { %>
                      <option value="<%= t.id %>" <%= t.id == sec.incharge_id ? 'selected' : '' %>><%= t.name %></option>
                    <% }) %>
                  </select>
                  <button type="submit">Set incharge</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="block">
    <h2>Current teaching assignments</h2>
    <p class="hint">Who teaches what, section by section.</p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Section</th><th>Subject</th><th>Teacher</th></tr>
        </thead>
        <tbody>
          <% if (currentAssignments.length === 0) { %>
            <tr><td class="empty" colspan="3">No assignments yet. Use the form above to assign the first teacher.</td></tr>
          <% } %>
          <% currentAssignments.forEach(a => { %>
            <tr>
              <td>Year <%= a.year %>, Section <%= a.section_name %></td>
              <td><%= a.subject_name %></td>
              <td><%= a.teacher_name %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</div>
</body>
</html>





