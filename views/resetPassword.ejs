<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="referrer" content="no-referrer">
<meta name="robots" content="noindex">
<title>Reset password | <%= collegeName %></title>
<link rel="icon" href="/images/college-crest.png">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root { --red:#BF0716; --gold:#E2B229; --cream:#FBF8F4; --ink:#1B1614; --muted:#6E625A; --ok:#2E7D32; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: 'Poppins', sans-serif; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px;
    background: linear-gradient(135deg, rgba(20,4,5,0.90) 0%, rgba(142,5,16,0.80) 100%), url('/images/campus-hero.jpg') center / cover no-repeat fixed;
  }
  .card { background: var(--cream); border-radius: 10px; padding: 36px 32px; width: 100%; max-width: 380px; text-align: center; border-top: 4px solid var(--gold); animation: cardIn .6s cubic-bezier(.2,.7,.2,1) both; }
  .card img.brand-logo { width: 100%; max-width: 270px; height: auto; margin: 0 auto 12px; display: block; mix-blend-mode: multiply; }
  .card h1 { font-family: 'Playfair Display', serif; font-size: 22px; color: var(--ink); margin-bottom: 6px; }
  .card p.sub { color: var(--muted); font-size: 13px; margin-bottom: 20px; line-height: 1.6; }
  input { width: 100%; padding: 12px; margin-bottom: 14px; border: 1px solid #D9CFC1; border-radius: 6px; font-family: inherit; font-size: 14px; background: #fff; transition: border-color .25s ease, box-shadow .25s ease; }
  input:focus { outline: none; border-color: var(--red); box-shadow: 0 0 0 3px rgba(191,7,22,.18); }
  button, a.btn { display: block; width: 100%; padding: 13px; background: linear-gradient(135deg, #BF0716 0%, #E8283A 100%); color: #fff; border: none; border-radius: 6px; font-family: inherit; font-weight: 600; font-size: 14px; cursor: pointer; text-decoration: none; transition: transform .15s ease, box-shadow .25s ease; }
  button:hover, a.btn:hover { background: linear-gradient(135deg, #8E0510 0%, #BF0716 100%); transform: translateY(-1px); box-shadow: 0 6px 14px rgba(191,7,22,.28); }
  .error { background: #FDECEA; color: var(--red); padding: 10px; border-radius: 6px; font-size: 13px; margin-bottom: 14px; animation: fadeIn .4s ease both; }
  .ok { background: #E8F5E9; color: var(--ok); padding: 12px; border-radius: 6px; font-size: 14px; margin-bottom: 18px; animation: fadeIn .4s ease both; }
  .hint { color: var(--muted); font-size: 12px; margin: -6px 0 14px; text-align: left; }
  .back { display: block; margin-top: 16px; color: var(--muted); font-size: 13px; text-decoration: none; transition: color .2s ease; }
  .back:hover { color: var(--red); }
  @keyframes cardIn { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  @view-transition { navigation: auto; }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }
</style>
</head>
<body>
  <div class="card">
    <img class="brand-logo" src="/images/avanthi-logo.png" alt="<%= collegeName %>">

    <% if (state === 'form') { %>
      <h1>Choose a new password</h1>
      <p class="sub">Pick a password you have not used before.</p>

      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>

      <form method="POST" action="/reset-password">
        <input type="hidden" name="token" value="<%= token %>">
        <input type="password" name="newPassword" placeholder="New password" required minlength="8" autocomplete="new-password">
        <p class="hint">At least 8 characters.</p>
        <input type="password" name="confirmPassword" placeholder="Confirm new password" required minlength="8" autocomplete="new-password">
        <button type="submit">Save new password</button>
      </form>

    <% } else if (state === 'done') { %>
      <h1>Password changed</h1>
      <div class="ok">Your password has been updated. You can log in now.</div>
      <a class="btn" href="<%= loginUrl %>">Go to log in</a>

    <% } else { %>
      <h1>This link cannot be used</h1>
      <p class="sub">It may have expired, or it has already been used. Reset links work once and last 30 minutes.</p>
      <a class="btn" href="/forgot-password">Request a new link</a>
      <a href="/login" class="back">&larr; Back to log in</a>
    <% } %>
  </div>
</body>
</html>