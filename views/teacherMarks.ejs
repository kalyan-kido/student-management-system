<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Enter Marks — <%= collegeName %></title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root { --dark:#2A0709; --red:#BF0716; --gold:#E2B229; --cream:#FBF8F4; --ink:#1B1614; --muted:#6E625A; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Inter', sans-serif; background: var(--cream); color: var(--ink); }
  nav { background: var(--dark); color: white; display: flex; justify-content: space-between; align-items: center; padding: 14px 28px; border-bottom: 3px solid var(--red); }
  nav a { color: var(--gold); text-decoration: none; font-size: 13px; }
  .container { max-width: 700px; margin: 0 auto; padding: 40px 20px; }
  h1 { font-family: 'Cormorant Garamond', serif; font-size: 26px; }
  p.sub { color: var(--muted); margin-top: 4px; margin-bottom: 24px; font-size: 14px; }
  table { width: 100%; border-collapse: collapse; background: white; border-radius: 8px; overflow: hidden; }
  th { background: var(--dark); color: white; padding: 12px; text-align: left; font-size: 12px; }
  td { padding: 10px 12px; border-top: 1px solid #E9E1D6; font-size: 14px; }
  input { padding: 8px; border: 1px solid #D9CFC1; border-radius: 5px; }
  button { margin-top: 20px; background: var(--red); color: white; border: none; padding: 12px 26px; border-radius: 6px; font-weight: 600; cursor: pointer; }

/* gradient-theme */
body { background-image: linear-gradient(160deg, #FBF8F4 0%, #F4E9DA 100%); background-attachment: fixed; }
nav { background: linear-gradient(120deg, #5C0810 0%, #8E0510 45%, #BF0716 100%) !important; border-bottom: 3px solid #E2B229 !important; }
th { background: linear-gradient(120deg, #2A0709, #5C0810) !important; }
button, .btn { background: linear-gradient(135deg, #BF0716 0%, #E8283A 100%) !important; transition: transform .15s ease, box-shadow .25s ease, filter .25s ease; }
button:hover, .btn:hover { background: linear-gradient(135deg, #8E0510 0%, #BF0716 100%) !important; transform: translateY(-1px); box-shadow: 0 6px 14px rgba(191,7,22,.3); }
button:active, .btn:active { transform: translateY(0); box-shadow: none; }

/* nav-crest */
nav > div:first-child { display: flex; align-items: center; gap: 10px; }
nav > div:first-child::before { content: ''; flex: none; width: 36px; height: 36px; border-radius: 50%; background: #fff url('/images/college-crest.png') center / 86% no-repeat; box-shadow: 0 0 0 2px #E2B229; }

/* page-transition */
@view-transition { navigation: auto; }
@keyframes vtOut { to { opacity: 0; transform: translateY(-8px); } }
@keyframes vtIn { from { opacity: 0; transform: translateY(12px); } }
::view-transition-old(root) { animation: .22s ease both vtOut; }
::view-transition-new(root) { animation: .4s ease both vtIn; }
@media (prefers-reduced-motion: reduce) {
  ::view-transition-group(*), ::view-transition-old(*), ::view-transition-new(*) { animation: none !important; }
}
/* motion-theme */
@keyframes riseIn { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
.container > * { animation: riseIn .55s cubic-bezier(.2,.7,.2,1) both; }
.container > *:nth-child(2) { animation-delay: .07s; }
.container > *:nth-child(3) { animation-delay: .14s; }
.container > *:nth-child(4) { animation-delay: .21s; }
.container > *:nth-child(5) { animation-delay: .28s; }
.container > *:nth-child(n+6) { animation-delay: .35s; }
.info-grid > *, .stats > *, .cards > * { animation: riseIn .5s cubic-bezier(.2,.7,.2,1) both; }
.info-grid > *:nth-child(2), .stats > *:nth-child(2), .cards > *:nth-child(2) { animation-delay: .08s; }
.info-grid > *:nth-child(3), .stats > *:nth-child(3), .cards > *:nth-child(3) { animation-delay: .16s; }
.info-grid > *:nth-child(n+4), .stats > *:nth-child(n+4), .cards > *:nth-child(n+4) { animation-delay: .24s; }
nav .links a { position: relative; transition: color .2s ease; }
nav .links a:hover { text-decoration: none; color: #fff; }
nav .links a::after { content: ''; position: absolute; left: 0; right: 0; bottom: -5px; height: 2px; background: #E2B229; transform: scaleX(0); transform-origin: left; transition: transform .28s ease; }
nav .links a:hover::after { transform: scaleX(1); }
tbody tr { transition: background-color .2s ease; }
tbody tr:hover { background-color: rgba(191,7,22,0.05); }
.table-wrap, form.stack { transition: box-shadow .3s ease; }
.table-wrap:hover, form.stack:hover { box-shadow: 0 12px 28px rgba(20,4,5,0.10); }
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation: none !important; transition: none !important; }
}
</style>
  <link rel="icon" href="/images/college-crest.png">
</head>
<body>
<nav>
  <div>Enter Marks</div>
  <a href="/teacher-dashboard">← Back to Dashboard</a>
</nav>
<div class="container">
  <h1><%= subject.name %></h1>
  <p class="sub">Section <%= section.section_name %> · Year <%= section.year %> · Semester 1</p>

  <form method="POST" action="/teacher/marks/<%= sectionId %>/<%= subjectId %>">
    <table>
      <thead>
        <tr><th>Student</th><th>University ID</th><th>Score / Max</th></tr>
      </thead>
      <tbody>
        <% students.forEach(s => { 
             const existing = marksMap[s.university_id];
        %>
          <tr>
            <td><%= s.name %></td>
            <td><%= s.university_id %></td>
            <td>
              <input type="number" step="0.01" name="<%= s.university_id %>_score" value="<%= existing ? existing.score : '' %>" style="width:70px;" placeholder="Score">
              /
              <input type="number" step="0.01" name="<%= s.university_id %>_max" value="<%= existing ? existing.max_score : 100 %>" style="width:60px;" placeholder="Max">
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <button type="submit">Save Marks</button>
  </form>
</div>
</body>
</html>